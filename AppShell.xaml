<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:BookLibrary.Views"
       x:Class="BookLibrary.AppShell"
       Shell.TabBarIsVisible="True">

    <TabBar>
        <Tab Title="О программе" Icon="info.png">
            <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" />
        </Tab>
        <Tab Title="Добавить" Icon="add.png">
            <ShellContent ContentTemplate="{DataTemplate views:AddItem}" />
        </Tab>
        <Tab Title="Каталог" Icon="list.png">
            <ShellContent ContentTemplate="{DataTemplate views:ItemPage}" />
        </Tab>
    </TabBar>

</Shell>
