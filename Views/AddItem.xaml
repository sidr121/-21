<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookLibrary.Views.AddItem"
             Title="Добавить книгу">
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Название книги *" FontAttributes="Bold"/>
                    <Entry x:Name="TitleEntry" Placeholder="Введите название" MaxLength="200"/>

                    <Label Text="Автор *" FontAttributes="Bold"/>
                    <Entry x:Name="AuthorEntry" Placeholder="Введите автора" MaxLength="150"/>

                    <Label Text="Жанр" FontAttributes="Bold"/>
                    <Entry x:Name="GenreEntry" Placeholder="Введите жанр" MaxLength="100"/>

                    <Label Text="Год издания" FontAttributes="Bold"/>
                    <Entry x:Name="YearEntry" Placeholder="Например: 2023" Keyboard="Numeric"/>

                    <Label Text="Количество страниц" FontAttributes="Bold"/>
                    <Entry x:Name="PageCountEntry" Placeholder="Введите количество страниц" Keyboard="Numeric"/>

                    <Button Text="Добавить книгу" Clicked="AddButton_Clicked" Margin="0,20,0,0"/>
                </StackLayout>
            </Frame>

            <Label Text="* - обязательные поля" FontSize="Small" TextColor="Gray" HorizontalOptions="Center"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
