<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookLibrary.Views.ItemPage"
             Title="Каталог книг"
             BackgroundColor="#F5F5F5">
    <StackLayout Padding="10" Spacing="10">
        <SearchBar x:Name="SearchBar" Placeholder="Поиск по названию, автору или жанру..." 
                   TextChanged="SearchBar_TextChanged"
                   BackgroundColor="White" TextColor="#212121" PlaceholderColor="#999999"/>

        <StackLayout Orientation="Horizontal" Spacing="10">
            <Button Text="Обновить" Clicked="UpdateButton_Clicked" HorizontalOptions="FillAndExpand" 
                    BackgroundColor="#2196F3" TextColor="White"/>
            <Button Text="Удалить выбранную" Clicked="DeleteButton_Clicked" HorizontalOptions="FillAndExpand" 
                    BackgroundColor="#F44336" TextColor="White"/>
        </StackLayout>

        <CollectionView x:Name="BooksListView" SelectionMode="Single" SelectionChanged="BooksListView_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" BorderColor="#E0E0E0" CornerRadius="5" Padding="10" Margin="5">
                        <StackLayout Spacing="5">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="Medium" TextColor="#2196F3"/>
                            <Label Text="{Binding Author}" FontSize="Small" TextColor="#212121"/>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding Genre, StringFormat='Жанр: {0}'}" FontSize="Small" TextColor="#757575"/>
                                <Label Text="{Binding Year, StringFormat='Год: {0}'}" FontSize="Small" TextColor="#757575"/>
                                <Label Text="{Binding PageCount, StringFormat='Стр: {0}'}" FontSize="Small" TextColor="#757575"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="InfoLabel" Text="Выберите книгу для удаления" FontSize="Small" TextColor="#757575" HorizontalOptions="Center"/>
    </StackLayout>
</ContentPage>
