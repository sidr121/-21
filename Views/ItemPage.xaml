<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookLibrary.Views.ItemPage"
             Title="Каталог книг">
    <StackLayout Padding="10" Spacing="10">
        <SearchBar x:Name="SearchBar" Placeholder="Поиск по названию, автору или жанру..." TextChanged="SearchBar_TextChanged"/>

        <StackLayout Orientation="Horizontal" Spacing="10">
            <Button Text="Обновить" Clicked="UpdateButton_Clicked" HorizontalOptions="FillAndExpand"/>
            <Button Text="Удалить выбранную" Clicked="DeleteButton_Clicked" BackgroundColor="Red" HorizontalOptions="FillAndExpand"/>
        </StackLayout>

        <CollectionView x:Name="BooksListView" SelectionMode="Single" SelectionChanged="BooksListView_SelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="LightGray" CornerRadius="5" Padding="10" Margin="5">
                        <StackLayout Spacing="5">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="Medium" TextColor="{StaticResource Primary}"/>
                            <Label Text="{Binding Author}" FontSize="Small"/>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding Genre, StringFormat='Жанр: {0}'}" FontSize="Small" TextColor="Gray"/>
                                <Label Text="{Binding Year, StringFormat='Год: {0}'}" FontSize="Small" TextColor="Gray"/>
                                <Label Text="{Binding PageCount, StringFormat='Стр: {0}'}" FontSize="Small" TextColor="Gray"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="InfoLabel" Text="Выберите книгу для удаления" FontSize="Small" TextColor="Gray" HorizontalOptions="Center"/>
    </StackLayout>
</ContentPage>
