<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookLibrary.Views.AboutPage"
             Title="О программе">
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="10" Padding="20">
                <StackLayout>
                    <Label Text="📚 Библиотека книг" FontSize="Large" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="Версия 1.0" TextColor="White" HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>

            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Описание" FontSize="Medium" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                    <Label Text="Мобильное приложение для управления каталогом книг с использованием локальной базы данных SQLite." LineBreakMode="WordWrap"/>
                </StackLayout>
            </Frame>

            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Возможности" FontSize="Medium" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                    <Label Text="✓ Добавление новых книг"/>
                    <Label Text="✓ Поиск по названию, автору и жанру"/>
                    <Label Text="✓ Удаление книг из каталога"/>
                    <Label Text="✓ Хранение данных в SQLite"/>
                </StackLayout>
            </Frame>

            <Frame BorderColor="LightGray" CornerRadius="10" Padding="15">
                <StackLayout Spacing="10">
                    <Label Text="Технологии" FontSize="Medium" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                    <Label Text="• .NET MAUI"/>
                    <Label Text="• SQLite"/>
                    <Label Text="• C#"/>
                    <Label Text="• XAML"/>
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>
</ContentPage>
